# syntax=docker/dockerfile:1

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 — Build Apache Paimon from the submodule source
# ─────────────────────────────────────────────────────────────────────────────
FROM maven:3.9-eclipse-temurin-17 AS paimon-builder

WORKDIR /build
COPY paimon/ .

# Build the Flink 2.1 connector + its transitive deps.
# -Pflink2 activates the flink2 profile (module is NOT in the default reactor).
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn clean package -DskipTests --no-transfer-progress \
        -Pflink2 \
        -pl paimon-flink/paimon-flink-2.1 --also-make \
        -Dmaven.repo.local=/root/.m2/repository

# Stage the connector jar to a fixed path.
RUN JAR=$(find /build/paimon-flink/paimon-flink-2.1/target \
              -maxdepth 1 -name "paimon-flink-*.jar") \
    && echo "==> Paimon Flink jar: $JAR ($(du -h "$JAR" | cut -f1))" \
    && cp "$JAR" /paimon-flink.jar

# Paimon requires Hadoop classes (marked 'provided' in its POM).
# Flink 2.x does not bundle Hadoop, so download the pre-bundled shaded jar
# via Maven (guaranteed network — it already fetched paimon deps above).
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn dependency:copy \
        -Dartifact=org.apache.flink:flink-shaded-hadoop-2-uber:2.8.3-10.0 \
        -DoutputDirectory=/hadoop \
        --no-transfer-progress \
        -Dmaven.repo.local=/root/.m2/repository \
    && ls -lh /hadoop/

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 — Flink 2.1 with S3 plugin + Paimon connector + Hadoop
# ─────────────────────────────────────────────────────────────────────────────
FROM flink:2.1-java17

# Activate the bundled S3-Hadoop filesystem plugin.
RUN mkdir -p /opt/flink/plugins/s3-fs-hadoop \
    && cp /opt/flink/opt/flink-s3-fs-hadoop-*.jar \
          /opt/flink/plugins/s3-fs-hadoop/

# Hadoop classes for Paimon (provides org.apache.hadoop.conf.Configuration etc.)
COPY --from=paimon-builder /hadoop/flink-shaded-hadoop-2-uber-2.8.3-10.0.jar /opt/flink/lib/

# Paimon Flink connector
COPY --from=paimon-builder /paimon-flink.jar /opt/flink/lib/paimon-flink.jar

# Cluster + S3A + SQL Gateway configuration
COPY flink/config.yaml /opt/flink/conf/config.yaml

# SQL init script for Paimon catalog
COPY flink/init.sql /opt/flink/init.sql

# SQL Gateway startup wrapper
COPY flink/sql-gateway-start.sh /sql-gateway-start.sh
RUN chmod +x /sql-gateway-start.sh
