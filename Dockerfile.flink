# syntax=docker/dockerfile:1

# ─────────────────────────────────────────────────────────────
# Мульти-архитектурная сборка.
#
#   BUILDPLATFORM  — хост (где крутится builder).
#   TARGETPLATFORM — куда компилируем итоговый образ.
#     = linux/amd64 или linux/arm64.
#
# На ARM mac для локального docker-compose TARGETPLATFORM
# автоматически = linux/arm64 (host-native), всё собирается нативно.
#
# Для кластерной сборки jar-ов amd64 Makefile прогоняет buildx с
# `--platform=linux/amd64`, Rust кросс-компилируется через zigbuild.
#
# Java-jar-ы платформенно-независимы, но нативка libvortex_jni.so и
# базовый flink-образ — per-arch. Rust triple и resources/native/...
# папка выбираются из TARGETARCH.
# ─────────────────────────────────────────────────────────────

FROM --platform=$BUILDPLATFORM rust:1.94 AS vortex-builder

ARG TARGETARCH
ARG ZIG_VERSION=0.13.0
ARG GLIBC_VERSION=2.28

RUN apt-get update && apt-get install -y --no-install-recommends \
        clang libclang-dev curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем zig под АРХИТЕКТУРУ БИЛДА (buildplatform). Он сам
# умеет кросс-компилить в любой target через --target.
RUN BUILD_ARCH=$(uname -m) \
    && curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-${BUILD_ARCH}-${ZIG_VERSION}.tar.xz" \
       | tar -xJ -C /opt \
    && ln -s "/opt/zig-linux-${BUILD_ARCH}-${ZIG_VERSION}/zig" /usr/local/bin/zig \
    && zig version

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install --locked cargo-zigbuild

# Рассчитываем Rust triple и имя native dir из TARGETARCH.
RUN case "${TARGETARCH}" in \
      amd64) echo x86_64-unknown-linux-gnu  > /rust_target ; echo linux-amd64   > /native_dir ;; \
      arm64) echo aarch64-unknown-linux-gnu > /rust_target ; echo linux-aarch64 > /native_dir ;; \
      *)     echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2 ; exit 1 ;; \
    esac

WORKDIR /vortex
COPY vortex/ .

# rustup target add должен выполняться из /vortex, чтобы rustup прочитал
# rust-toolchain.toml и поставил std для запиненного тулчейна.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/vortex/target \
    RUST_TARGET=$(cat /rust_target) \
    && rustup target add ${RUST_TARGET} \
    && cargo zigbuild --package vortex-jni --release \
        --target ${RUST_TARGET}.${GLIBC_VERSION} \
    && cp target/${RUST_TARGET}/release/libvortex_jni.so /libvortex_jni.so \
    && echo "=== GLIBC versions required by libvortex_jni.so ===" \
    && objdump -T /libvortex_jni.so | grep -oE 'GLIBC_[0-9.]+' | sort -u

# ─────────────────────────────────────────────────────────────
# Maven-сборка paimon-jar-ов. Тоже на BUILDPLATFORM — Java
# bytecode платформенно-независим.
# ─────────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM maven:3.9.9-eclipse-temurin-17 AS paimon-builder

WORKDIR /build
COPY paimon/ .

COPY --from=vortex-builder /libvortex_jni.so /tmp/libvortex_jni.so
COPY --from=vortex-builder /native_dir /tmp/native_dir
RUN NATIVE_DIR=$(cat /tmp/native_dir) \
    && mkdir -p paimon-vortex/paimon-vortex-jni/src/main/resources/native/${NATIVE_DIR} \
    && cp /tmp/libvortex_jni.so \
       paimon-vortex/paimon-vortex-jni/src/main/resources/native/${NATIVE_DIR}/libvortex_jni.so \
    && echo "Copied to native/${NATIVE_DIR}/"

RUN --mount=type=cache,target=/root/.m2/repository \
    mvn clean install -DskipTests --no-transfer-progress \
        -Pflink2 \
        -pl paimon-flink/paimon-flink-2.2,paimon-vortex/paimon-vortex-format,paimon-lance \
        --also-make \
        -Dmaven.repo.local=/root/.m2/repository

RUN cp paimon-flink/paimon-flink-2.2/target/paimon-flink-2.2-1.4.0.jar /paimon-flink.jar \
    && ls -lh /paimon-flink.jar

RUN --mount=type=cache,target=/root/.m2/repository \
    mvn dependency:copy-dependencies \
        -pl paimon-vortex/paimon-vortex-format \
        --no-transfer-progress \
        -DoutputDirectory=/vortex-libs \
        -DincludeScope=runtime \
        -DexcludeGroupIds=org.apache.paimon \
        -Dmaven.repo.local=/root/.m2/repository \
    && cp paimon-vortex/paimon-vortex-format/target/paimon-vortex-format-1.4.0.jar /vortex-libs/ \
    && cp paimon-vortex/paimon-vortex-jni/target/paimon-vortex-jni-1.4.0.jar /vortex-libs/ \
    && cp paimon-arrow/target/paimon-arrow-1.4.0.jar /vortex-libs/ \
    && ls -lh /vortex-libs/

# ── Lance: native lib уже в lance-core.jar (Maven central), компилировать не надо. ──
# Транзитивные deps по комментарию paimon-lance/pom.xml: lance-core, questdb/jar-jni,
# flatbuffers-java, jackson-*, eclipse-collections, arrow-* (paimon-arrow уже в /vortex-libs).
RUN --mount=type=cache,target=/root/.m2/repository \
    mvn dependency:copy-dependencies \
        -pl paimon-lance \
        --no-transfer-progress \
        -DoutputDirectory=/lance-libs \
        -DincludeScope=runtime \
        -DexcludeGroupIds=org.apache.paimon \
        -Dmaven.repo.local=/root/.m2/repository \
    && cp paimon-lance/target/paimon-lance-1.4.0.jar /lance-libs/ \
    && ls -lh /lance-libs/

RUN --mount=type=cache,target=/root/.m2/repository \
    mvn dependency:copy \
        -Dartifact=org.apache.flink:flink-shaded-hadoop-2-uber:2.8.3-10.0 \
        -DoutputDirectory=/hadoop \
        --no-transfer-progress \
        -Dmaven.repo.local=/root/.m2/repository \
    && ls -lh /hadoop/

# ─────────────────────────────────────────────────────────────
# Финальный flink-образ под TARGETPLATFORM (multi-arch).
# Без digest-pin — buildx подтянет amd64 или arm64 автоматически.
# ─────────────────────────────────────────────────────────────
FROM flink:2.2-java17

RUN mkdir -p /opt/flink/plugins/s3-fs-hadoop \
    && cp /opt/flink/opt/flink-s3-fs-hadoop-*.jar \
          /opt/flink/plugins/s3-fs-hadoop/

COPY --from=paimon-builder /hadoop/ /opt/flink/lib/
COPY --from=paimon-builder /paimon-flink.jar /opt/flink/lib/paimon-flink.jar
COPY --from=paimon-builder /vortex-libs/ /opt/flink/lib/
COPY --from=paimon-builder /lance-libs/ /opt/flink/lib/
COPY flink/config.yaml /opt/flink/conf/config.yaml
COPY flink/init.sql /opt/flink/init.sql
COPY --chmod=755 flink/sql-gateway-start.sh /sql-gateway-start.sh
