# syntax=docker/dockerfile:1

FROM rust:1.94 AS vortex-builder

# Кросс-компилируем .so на x86_64-unknown-linux-gnu с glibc 2.28 через
# cargo-zigbuild. Контейнер при этом запускается нативно под платформу
# билд-хоста (на mac arm64 — linux/arm64), без qemu-эмуляции — так быстрее
# в разы, чем --platform=linux/amd64. Zig подкладывает sysroot с нужной
# версией glibc, итоговый .so работает на нодах с glibc >= 2.28.
ARG ZIG_VERSION=0.13.0
ARG RUST_TARGET=x86_64-unknown-linux-gnu
ARG GLIBC_VERSION=2.28

RUN apt-get update && apt-get install -y --no-install-recommends \
        clang libclang-dev curl xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN BUILD_ARCH=$(uname -m) \
    && curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-${BUILD_ARCH}-${ZIG_VERSION}.tar.xz" \
       | tar -xJ -C /opt \
    && ln -s "/opt/zig-linux-${BUILD_ARCH}-${ZIG_VERSION}/zig" /usr/local/bin/zig \
    && zig version

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install --locked cargo-zigbuild

WORKDIR /vortex
COPY vortex/ .

# rustup target add должен выполняться из /vortex, чтобы rustup прочитал
# rust-toolchain.toml и поставил std для запиненного тулчейна (иначе std
# ставится для дефолтного, а билд падает с "can't find crate for core").
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/vortex/target \
    rustup target add ${RUST_TARGET} \
    && cargo zigbuild --package vortex-jni --release \
        --target ${RUST_TARGET}.${GLIBC_VERSION} \
    && cp target/${RUST_TARGET}/release/libvortex_jni.so /libvortex_jni.so \
    && echo "=== GLIBC versions required by libvortex_jni.so ===" \
    && objdump -T /libvortex_jni.so | grep -oE 'GLIBC_[0-9.]+' | sort -u

FROM maven:3.9.9-eclipse-temurin-17 AS paimon-builder

# Java-jar-ы платформонезависимые, но нативка внутри paimon-vortex-jni
# должна лечь в папку, соответствующую таргет-платформе нод кластера.
# Хардкодим linux-amd64, т.к. кросс-компиляция выше делается именно под него.
ARG NATIVE_DIR=linux-amd64

WORKDIR /build
COPY paimon/ .

COPY --from=vortex-builder /libvortex_jni.so /tmp/libvortex_jni.so
RUN mkdir -p paimon-vortex/paimon-vortex-jni/src/main/resources/native/${NATIVE_DIR} \
    && cp /tmp/libvortex_jni.so \
       paimon-vortex/paimon-vortex-jni/src/main/resources/native/${NATIVE_DIR}/libvortex_jni.so \
    && echo "Copied to native/${NATIVE_DIR}/"

RUN --mount=type=cache,target=/root/.m2/repository \
    mvn clean install -DskipTests --no-transfer-progress \
        -Pflink2 \
        -pl paimon-flink/paimon-flink-2.2,paimon-vortex/paimon-vortex-format \
        --also-make \
        -Dmaven.repo.local=/root/.m2/repository

RUN cp paimon-flink/paimon-flink-2.2/target/paimon-flink-2.2-1.4.0.jar /paimon-flink.jar \
    && ls -lh /paimon-flink.jar

RUN --mount=type=cache,target=/root/.m2/repository \
    mvn dependency:copy-dependencies \
        -pl paimon-vortex/paimon-vortex-format \
        --no-transfer-progress \
        -DoutputDirectory=/vortex-libs \
        -DincludeScope=runtime \
        -DexcludeGroupIds=org.apache.paimon \
        -Dmaven.repo.local=/root/.m2/repository \
    && cp paimon-vortex/paimon-vortex-format/target/paimon-vortex-format-1.4.0.jar /vortex-libs/ \
    && cp paimon-vortex/paimon-vortex-jni/target/paimon-vortex-jni-1.4.0.jar /vortex-libs/ \
    && cp paimon-arrow/target/paimon-arrow-1.4.0.jar /vortex-libs/ \
    && ls -lh /vortex-libs/

RUN --mount=type=cache,target=/root/.m2/repository \
    mvn dependency:copy \
        -Dartifact=org.apache.flink:flink-shaded-hadoop-2-uber:2.8.3-10.0 \
        -DoutputDirectory=/hadoop \
        --no-transfer-progress \
        -Dmaven.repo.local=/root/.m2/repository \
    && ls -lh /hadoop/

FROM flink:2.2-java17@sha256:354a4828677d6e8a7dbd1e8fceaf803ba0a603c6c841808807bb00cec88c5b9e

RUN mkdir -p /opt/flink/plugins/s3-fs-hadoop \
    && cp /opt/flink/opt/flink-s3-fs-hadoop-*.jar \
          /opt/flink/plugins/s3-fs-hadoop/

COPY --from=paimon-builder /hadoop/ /opt/flink/lib/
COPY --from=paimon-builder /paimon-flink.jar /opt/flink/lib/paimon-flink.jar
COPY --from=paimon-builder /vortex-libs/ /opt/flink/lib/
COPY flink/config.yaml /opt/flink/conf/config.yaml
COPY flink/init.sql /opt/flink/init.sql
COPY --chmod=755 flink/sql-gateway-start.sh /sql-gateway-start.sh
